# Todas opcionais. Sem elas, o motor usa as pastas do repositório e o PATH.
# Nenhum segredo é necessário: o motor roda 100% local.

# Pasta com .ttf/.otf da sua identidade (default: fonts/)
VIDEO_IA_FONTS=
# Modelo YuNet de detecção de rosto (default: models/face_detection_yunet*.onnx)
VIDEO_IA_YUNET=
# Identidade visual (cores, fontes, textos) (default: config/identidade_exemplo.json)
VIDEO_IA_IDENTIDADE=
# Pronúncia de siglas do seu domínio para o alinhador (default: config/pronuncias_exemplo.json)
VIDEO_IA_PRONUNCIAS=
# Palavras que não podem sumir / trechos proibidos (default: config/palavras_criticas_exemplo.json)
VIDEO_IA_CRITICAS=
# Modelo do faster-whisper para retranscrição local no alinhador (default: large-v3)
VIDEO_IA_WHISPER_MODELO=
# Binários do ffmpeg, se não estiverem no PATH
VIDEO_IA_FFMPEG=
VIDEO_IA_FFPROBE=
